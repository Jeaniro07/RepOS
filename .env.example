# cp .env.example .env  -> isi semua nilai. Buat rahasia dengan: openssl rand -hex 32
MURMUR_HERMES_PASSWORD=
MURMUR_HERMES_SECRET=
# MURMUR_PASSWORD wajib: kosong = Murmur tanpa login, compose menolak start.
MURMUR_PASSWORD=
# Dua token per bot, HARUS berbeda:
#  - COMPUTER: sidecar -> komputer (membuka semua API OpenBot, termasuk /exec). Hanya sidecar yang memegangnya.
#  - MCP: Hermes -> sidecar (hanya 12 tool browser/berkas dengan allowlist domain).
OPS_COMPUTER_TOKEN=
OPS_MCP_TOKEN=
# Domain yang boleh dibuka browser Ops Holding (koma). "*" = bebas (tidak disarankan).
OPS_ALLOWED_DOMAINS=
# Kunci LLM untuk Hermes (nama variabel mengikuti provider yang dipilih di Hermes).
# ANTHROPIC_API_KEY=
# Verifier LLM untuk Auto Review (endpoint OpenAI-compatible, mis. OpenRouter). Opsional.
# Hanya aturan ber-`llm: true` di policy.yaml yang memakainya; uang/pembayaran tetap ke manusia.
REVIEW_LLM_URL=
REVIEW_LLM_MODEL=
REVIEW_LLM_KEY=
