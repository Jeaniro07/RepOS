# Ditambahkan ke .env Rakazo oleh run.sh (nama variabel sudah dicocokkan dengan
# infra/compose/.env.images.example & docs/self-host.md di commit 08ee8cf).

# Komputer bot: hanya internet publik (blokir host, LAN/RFC1918, CGNAT, metadata).
# Wajib jalankan `sudo bash restrict-computer-egress.sh` di host (run.sh --egress).
SANDBOX_COMPUTER_EGRESS=restricted
SANDBOX_COMPUTER_DNS=1.1.1.1,1.0.0.1

# Batasi sumber daya komputer bot supaya tidak menghabiskan home lab.
RAKAZO_COMPUTER_MEMORY=2g
RAKAZO_COMPUTER_CPUS=1

# Model: isi salah satu. Kunci diisi manual di .env, jangan di file ini.
# OPENROUTER_API_KEY=
# Atau endpoint OpenAI-compatible di LAN (Ollama dsb.), bukan 127.0.0.1 dari dalam container:
# RAKAZO_LOCAL_MODELS=qwen3:4b
# RAKAZO_LOCAL_MODELS_URL=http://192.168.x.x:11434/v1

# Auto Review: verifier default = LLM deployment. Opsional TypeSafe Jev:
# RAKAZO_AUTO_REVIEW_PROVIDER=jev
# TYPESAFE_API_KEY=
